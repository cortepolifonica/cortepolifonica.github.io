<script>
function toggleModal(show) {
  var x = document.getElementById("modal-action");
  //if (x.style.display === "none") {
  if (show) {
    x.style.display = "block";
  } else {
    x.style.display = "none";
  }
}

(function () {
  var carousel = document.getElementById("video-carousel");
  if (!carousel) return;

  var track = carousel.querySelector("[data-carousel-track]");
  var slides = track.children;
  var dotsContainer = carousel.querySelector("[data-carousel-dots]");
  var current = 0;

  function goTo(index) {
    current = (index + slides.length) % slides.length;
    track.style.transform = "translateX(-" + (current * 100) + "%)";
    updateDots();
  }

  function updateDots() {
    var dots = dotsContainer.children;
    for (var i = 0; i < dots.length; i++) {
      dots[i].classList.toggle("bg-opacity-100", i === current);
      dots[i].classList.toggle("bg-opacity-50", i !== current);
    }
  }

  // Build dots
  for (var i = 0; i < slides.length; i++) {
    (function (idx) {
      var dot = document.createElement("button");
      dot.type = "button";
      dot.setAttribute("aria-label", "Vai al video " + (idx + 1));
      dot.className = "w-3 h-3 bg-white rounded-full bg-opacity-50 focus:outline-none";
      dot.addEventListener("click", function () { goTo(idx); });
      dotsContainer.appendChild(dot);
    })(i);
  }

  carousel.querySelector("[data-carousel-prev]").addEventListener("click", function () { goTo(current - 1); });
  carousel.querySelector("[data-carousel-next]").addEventListener("click", function () { goTo(current + 1); });

  goTo(0);
})();
</script>
